# PulseCharts backend env (Section 15). Copy to .env and fill in.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — Postgres in production (Section 3). Leave unset locally to use the
# SQLite fallback. Example: postgres://user:pass@localhost:5432/pulsecharts
# DATABASE_URL=

# Redis (Channels layer + relay pub/sub)
REDIS_URL=redis://127.0.0.1:6379/0

# Hyperliquid (Section 6). Testnet: wss://api.hyperliquid-testnet.xyz/ws
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# Forex data (Yahoo Finance). No API key/account needed — works from any region.
# Set FOREX_ENABLED=false to turn forex off entirely (crypto is unaffected).
FOREX_ENABLED=true
# Seconds between relay polls of Yahoo for watched forex charts.
FOREX_POLL_INTERVAL=10

# Signal engine tuning (apps/signals). All optional — code has sensible defaults.
# EMA-alignment gate every non-breakout signal must pass before it can fire:
#   stack50   (default) EMA9>EMA21>EMA50  — looser, more signals (backtest winner)
#   stack200            EMA9>EMA21>EMA200 — strict major-trend stack, fewest signals
#   filter200           close>EMA200 and EMA9>EMA21
SIGNAL_EMA_GATE=stack50
# Engine mode: "hybrid" (rules pick direction, LLM annotates) or "llm_gate".
# SIGNAL_ENGINE_MODE=hybrid
# Minimum ADX for a trend signal (regime filter); 1h/4h checked vs the next frame up.
# One flat floor for every day of the week. 25 is the measured optimum — higher (30)
# buys already-extended moves that revert, lower admits chop.
# SIGNAL_ADX_MIN=25

# SEPARATE conviction floor for mean-reversion strategies. Fades are scored by a
# different branch of confidence_score than trend setups, so one flat floor cuts the
# two families at different effective strictnesses: measured at a flat 80, the floor
# gained every trend strategy 1.6-2.9 points of win rate but cost VWAP Stretch
# 56.7%->52.1% and BB Fade 53.6%->50.8%, discarding ~68% of their setups — the ones it
# kept were WORSE than the ones it dropped. Fades feel this more than anything else
# because they run at SIGNAL_CONFLUENCE_MIN_REVERSION=1 (they fire alone), so this
# floor is the only delivery gate between them and the user.
# 0 / unset = use SIGNAL_MIN_CONFIDENCE for both.
# SIGNAL_MIN_CONFIDENCE_REVERSION=70

# PER-STRATEGY floor overrides — the finest of the three levels, resolved
# strategy -> kind -> global. Format "slug:floor,slug:floor"; empty = no overrides.
# A malformed entry raises at startup rather than being skipped: a typo'd slug would
# silently leave that strategy on the kind floor while you believed it was overridden.
#
# Needed because the three fades respond to the confidence score in three DIFFERENT
# directions. Measured back-to-back on one window:
#     floor      RSI(2)         BB Fade        VWAP Stretch
#     65      54.2% n=631    53.8% n=1596    57.1% n=665
#     70      55.3% n=369    53.5% n=1389    56.5% n=531
#     75      63.5% n=159    53.6% n=959     54.9% n=348
# RSI(2) climbs steeply (+0.20R -> +0.46R), BB Fade is flat, VWAP Stretch is INVERTED
# (worse as the score rises). No single reversion number can serve all three.
# Caveats before leaning on this: RSI(2) at 75 is a thin sample (n=159), and the VWAP
# Stretch inversion is UNEXPLAINED — a strategy that does worse when it looks more
# convincing usually means the score reads something backwards for it.
# SIGNAL_MIN_CONFIDENCE_BY_STRATEGY=rsi2-reversion:75

# ADX CEILING for mean-reversion strategies — the mirror of SIGNAL_ADX_MIN above.
# Fades only fire at or below it. Keep the two EQUAL: at 20 (the old default) nothing
# could fire between ADX 20 and 25, and closing that band measured +79% more BB Fade
# trades at a BETTER win rate. Trend takes >= 25, fades take everything below.
SIGNAL_ADX_MAX_REVERSION=25

# Per-weekday override of the above (UTC weekday), parked at 0 = fall back to
# SIGNAL_ADX_MIN. Set a day to split it out (the early week ranges more, so Mon/Tue
# demanding a stronger trend than Wed-Fri is the usual reason to).
# SIGNAL_ADX_MIN_MON=0
# SIGNAL_ADX_MIN_TUE=0
# SIGNAL_ADX_MIN_WED=0
# SIGNAL_ADX_MIN_THU=0
# SIGNAL_ADX_MIN_FRI=0
# SIGNAL_ADX_MIN_SAT=0
# SIGNAL_ADX_MIN_SUN=0
# Require the higher timeframe's 200-EMA bias to agree (1h->4h, 4h->1d). This is a
# second 200 EMA on another frame, separate from SIGNAL_EMA200_TREND_FILTER (which
# governs the signal's own frame). Off = the 200 EMA still decides trend, on the
# entry timeframe only; roughly 2x the signal volume. (default true)
# Set this EXPLICITLY. Independent of SIGNAL_EMA200_TREND_FILTER since 2026-07-31
# (they were chained, so turning the on-frame 200 EMA off used to disable this too).
# Unset = the default (true) applies and the gate is ON, which cuts scan volume hard.
# SIGNAL_HTF_REGIME_ENABLED=false
# Overextension guard (A): block NEW non-breakout entries once price has stretched
# more than this many ATRs beyond EMA21 — stops chasing a parabolic blow-off. 0
# disables; breakout strategies are exempt. (default 2.5)
# SIGNAL_OVEREXT_ATR_MULT=2.5
# Overbought/oversold cap (B): reject NEW non-breakout entries at an RSI extreme —
# no BUY above SIGNAL_RSI_OVERBOUGHT, no SELL below SIGNAL_RSI_OVERSOLD. Catches the
# sustained-trend chase (BUY at RSI 72 near the high) the distance guard can't see.
# 0 disables a bound; breakouts exempt. Raise toward 78-80 to ride trends harder.
# (defaults 70 / 30)
# SIGNAL_RSI_OVERBOUGHT=70
# SIGNAL_RSI_OVERSOLD=30
# Re-entry cooldown (C): after a same-direction signal on a (symbol, strategy,
# timeframe) closes, suppress a fresh one in that direction for this many BARS —
# stops a runaway trend re-issuing the same BUY every scan. 0 disables; flips are
# never delayed. (default 3)
# SIGNAL_REENTRY_COOLDOWN_BARS=3

# Stop width for TREND strategies, in ATR multiples (crypto).
# 3.0/4.5, reverted 2026-08-09 from a 3-day trial of 2.0/3.0. The tighter band
# measured better ONLY under the scale-out model (hold a runner to TP3); if the
# trader closes everything at TP1 the two are level, and users said they prefer
# more TP1 hits and fewer stop-outs. See settings.py for the full numbers.
# Forex has its own band; mean-reversion strategies ignore both.
SIGNAL_ATR_FLOOR_CRYPTO=3.0
SIGNAL_ATR_CAP_CRYPTO=4.5

# NOTE: env-only changes need `docker compose up -d --force-recreate <svc>`
# (a plain `restart` does NOT reload .env).

# Dodo Payments (Section 3, 16). DODO_PAYMENTS_MODE: "test" (no real charges) or
# "live". API key + product IDs must come from the SAME mode's Dodo dashboard.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_MODE=test
DODO_PRICE_STARTER=
DODO_PRICE_PRO=

# Frontend origin (CORS + billing redirects)
FRONTEND_URL=http://localhost:5173

# Transactional email (Resend). Optional — without RESEND_API_KEY the password
# reset + payment confirmation emails log and no-op. The From address must use a
# domain verified in the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=PulseCharts <noreply@getpulsecharts.com>
# Where the landing-page "Contact us" form delivers messages (your inbox).
CONTACT_US_EMAIL=
# Where "you got paid" alerts go, sent from the Paystack webhook on a VERIFIED charge
# (customer, plan, amount, reference, and the referrer + commission owed if any).
# Defaults to CONTACT_US_EMAIL; empty disables the alert. The customer's own payment
# confirmation is sent regardless.
PAYMENT_ALERT_EMAIL=getpulsecharts@gmail.com

# Auto-trade / broker execution (v2). OFF until accuracy + legal review are done.
AUTO_TRADE_ENABLED=false
# Fernet key for encrypting broker API secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROKER_ENCRYPTION_KEY=
# Sizing is FIXED-MARGIN (not % of balance): each trade commits this many USDT of
# margin (user can override per account), leverage auto-picked to clear the exchange
# minimum while keeping liquidation beyond the stop. Capital at risk per trade = this
# margin; total at risk ≈ margin × max open positions.
AUTO_TRADE_DEFAULT_MARGIN_USD=1.0
AUTO_TRADE_MAX_OPEN_POSITIONS=5
AUTO_TRADE_MAX_DAILY_TRADES=10
AUTO_TRADE_MAX_SLIPPAGE_PCT=0.5
AUTO_TRADE_MAX_SIGNAL_AGE_SEC=600
# Scale a trade out across TP1/TP2/TP3 (the 50/25/25 ladder of §19.2) as reduce-only
# limit rungs, trailing the stop to breakeven after TP1 fills. Positions too small to
# split into placeable rungs fall back to the single-TP bracket below.
AUTO_TRADE_SCALEOUT=true
# Force the account into ISOLATED margin before placing (sizing assumes it — under
# cross margin a trade can lose more than its margin). Trades are rejected, not
# placed, if the switch fails. false = leave the account's margin mode untouched.
AUTO_TRADE_ISOLATED_MARGIN=true
# Single take-profit level for the FALLBACK only (scale-out off / too small to ladder):
# tp1 | tp2 | tp3.
AUTO_TRADE_TP_LEVEL=tp2
# How often (seconds) the place / reconcile tasks run.
AUTO_TRADE_PLACE_INTERVAL=120
AUTO_TRADE_RECONCILE_INTERVAL=60

# --- Referral commission ---------------------------------------------------
# Percentage of each payment credited to whoever referred the payer. Earned on a
# VERIFIED Paystack charge, recorded as a ReferralCommission row, and settled out
# of band — mark it paid in Django admin once the money has actually been sent.
# Voided automatically if the charge is refunded or disputed.
#
# Separate from the $1 signup credit (User.referral_credits), which is spent
# in-app: this is real revenue share and is never redeemable for a plan.
# 0 disables commissions entirely. Applies to every Starter/Pro payment a referred
# user makes, not only their first — but NOT to Pro Lifetime, which pays no
# commission (one-time revenue, perpetual cost to serve).
REFERRAL_COMMISSION_PCT=20
# Growth promo: every referral link grants the new user 30 days of Starter.
# Set false to end the promo — per-code flags are untouched, so it can be switched
# back on later unchanged. Attribution and the referrer's $1 credit are unaffected.
REFERRAL_SIGNUP_GRANT_ENABLED=true
# Minimum commission balance (USD) before a referrer may request a USDT TRC20 payout.
REFERRAL_MIN_WITHDRAWAL_USD=10

# --- Admin promo codes ---------------------------------------------------
# Codes you share so specific users can self-upgrade for a fixed window from the
# Plan & Billing page. Same redeem endpoint accepts either; empty = disabled.
# The Starter code never downgrades an active Pro user.
ADMIN_PRO_CODE=
ADMIN_PRO_DAYS=30
ADMIN_STARTER_CODE=
ADMIN_STARTER_DAYS=30
